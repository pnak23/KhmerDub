# KhmerDub AI - local environment. Copy to .env and fill in.
# Read by: docker compose (--env-file), Spring Boot (spring.config.import) and the Python service.
# Use FORWARD SLASHES in paths (this file is also parsed as a Java .properties file,
# where a backslash is an escape character). No quotes around values.

# --- Storage (outside the git repo) ---
KHMERDUB_STORAGE_ROOT=D:/KhmerDub/data
KHMERDUB_FFMPEG_DIR=D:/KhmerDub/tools/ffmpeg/bin

# --- Shared secret for internal Spring <-> Python calls (generate a long random value) ---
KHMERDUB_INTERNAL_TOKEN=change-me

# --- Ports (all services bind to 127.0.0.1) ---
WEB_PORT=3000
API_PORT=8180
AI_PORT=8765
POSTGRES_PORT=5442
REDIS_PORT=6380

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=khmerdub
POSTGRES_USER=khmerdub
POSTGRES_PASSWORD=change-me

# --- Cloud providers: OFF by default. Keys live only here, never in apps/web. ---
KHMERDUB_CLOUD_ENABLED=false
GEMINI_API_KEY=
HF_TOKEN=
